# ============================================================
# Fruvia AI Environment Configuration
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is in .gitignore.
# ============================================================

# ---------- App ----------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_VERSION=0.1.0

# ---------- Qdrant Cloud ----------
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=fruvia_fruits360_original_dinov2_base_v1
QDRANT_TIMEOUT=10

# ---------- Upload Limits ----------
MAX_UPLOAD_MB=10

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ---------- Logging ----------
LOG_LEVEL=INFO
